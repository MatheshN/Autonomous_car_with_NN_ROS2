<?xml version="1.0"?>
<robot name="car_sim">

  <!-- ============================================================
       Vehicle parameters
       ============================================================ -->
  <link name="base_footprint">
  </link>

  <link name="base_link">
    <visual>
      <origin xyz="0.035 0 0.025" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://car_description/meshes/orange_body.dae"
              scale="1 1 1"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0.035 0 0.025" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://car_description/meshes/body_collision.stl"
              scale="1 1 1"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1620.0"/>
      <inertia
        ixx="394.2"
        ixy="0"
        ixz="0"
        iyy="1657.26"
        iyz="0"
        izz="1954.26"/>
    </inertial>
  </link>

  <!-- base_footprint -> base_link -->
  <joint name="base_link_joint" type="fixed">
    <origin xyz="1.326 0 0.36" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>


  <!-- ============================================================
       REAR LEFT WHEEL
       ============================================================ -->
  <link name="wheel_rl">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 3.1415926535 0"/>
      <geometry>
        <mesh filename="package://car_description/meshes/wheel.dae"
              scale="1 1 1"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.36" length="0.25"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="40.0"/>
      <inertia
        ixx="1.7533333333"
        ixy="0"
        ixz="0"
        iyy="1.7533333333"
        iyz="0"
        izz="2.592"/>
    </inertial>
  </link>

  <joint name="wheel_rl_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rl"/>
    <origin xyz="-1.326 0.8 0" rpy="-1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>


  <!-- ============================================================
       REAR RIGHT WHEEL
       ============================================================ -->
  <link name="wheel_rr">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <mesh filename="package://car_description/meshes/wheel.dae"
              scale="1 1 1"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.36" length="0.25"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="40.0"/>
      <inertia
        ixx="1.7533333333"
        ixy="0"
        ixz="0"
        iyy="1.7533333333"
        iyz="0"
        izz="2.592"/>
    </inertial>
  </link>

  <joint name="wheel_rr_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rr"/>
    <origin xyz="-1.326 -0.8 0" rpy="-1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>


  <!-- ============================================================
       FRONT LEFT STEERING ASSEMBLY
       ============================================================ -->
  <link name="steer_fl">
    <inertial>
      <origin xyz="-0.013054 -0.0295 0" rpy="0 0 0"/>
      <mass value="20.0"/>
      <inertia
        ixx="2"
        ixy="0"
        ixz="0"
        iyy="2"
        iyz="0"
        izz="2"/>
    </inertial>
  </link>

  <joint name="steer_fl_joint" type="revolute">
    <parent link="base_link"/>
    <child link="steer_fl"/>
    <origin xyz="1.326 0.819 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="1000" velocity="10"/>
  </joint>

  <link name="wheel_fl">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 3.1415926535 0"/>
      <geometry>
        <mesh filename="package://car_description/meshes/wheel.dae"
              scale="1 1 1"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.36" length="0.25"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="40.0"/>
      <inertia
        ixx="1.7533333333"
        ixy="0"
        ixz="0"
        iyy="1.7533333333"
        iyz="0"
        izz="2.592"/>
    </inertial>
  </link>

  <joint name="wheel_fl_joint" type="continuous">
    <parent link="steer_fl"/>
    <child link="wheel_fl"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>


  <!-- ============================================================
       FRONT RIGHT STEERING ASSEMBLY
       ============================================================ -->
  <link name="steer_fr">
    <inertial>
      <origin xyz="-0.013054 -0.0295 0" rpy="0 0 0"/>
      <mass value="20.0"/>
      <inertia
        ixx="2"
        ixy="0"
        ixz="0"
        iyy="2"
        iyz="0"
        izz="2"/>
    </inertial>
  </link>

  <joint name="steer_fr_joint" type="revolute">
    <parent link="base_link"/>
    <child link="steer_fr"/>
    <origin xyz="1.326 -0.819 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="1000" velocity="10"/>
  </joint>

  <link name="wheel_fr">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <mesh filename="package://car_description/meshes/wheel.dae"
              scale="1 1 1"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.36" length="0.25"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="40.0"/>
      <inertia
        ixx="1.7533333333"
        ixy="0"
        ixz="0"
        iyy="1.7533333333"
        iyz="0"
        izz="2.592"/>
    </inertial>
  </link>

  <joint name="wheel_fr_joint" type="continuous">
    <parent link="steer_fr"/>
    <child link="wheel_fr"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

</robot>
