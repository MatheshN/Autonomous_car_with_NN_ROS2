<?xml version="1.0"?>

<robot name="car_sim"
       xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================================= -->
  <!-- VEHICLE PARAMETERS                                        -->
  <!-- ========================================================= -->

  <xacro:property name="half_front_track_width" value="0.819"/>
  <xacro:property name="half_rear_track_width" value="0.800"/>
  <xacro:property name="half_wheelbase" value="1.326"/>

  <xacro:property name="wheel_radius" value="0.36"/>
  <xacro:property name="wheel_thickness" value="0.25"/>
  <xacro:property name="wheel_mass" value="40.0"/>

  <xacro:property name="body_mass" value="1620.0"/>

  <xacro:property
    name="body_width"
    value="${2.0 * half_rear_track_width}"/>

  <xacro:property
    name="body_depth"
    value="${2.0 * half_wheelbase + 0.8}"/>

  <xacro:property
    name="body_length"
    value="0.6"/>


  <!-- ========================================================= -->
  <!-- ARGUMENTS                                                 -->
  <!-- ========================================================= -->

  <xacro:arg name="blue" default="false"/>


  <!-- ========================================================= -->
  <!-- REAR WHEEL MACRO                                          -->
  <!-- ========================================================= -->

  <xacro:macro name="rear_wheel"
               params="name x y z flip">

    <link name="wheel_${name}">

      <visual>

        <origin
          xyz="0 0 0"
          rpy="1.57079632679 ${flip * 3.14159265359} 0"/>

        <geometry>
          <mesh
            filename="package://car_description/meshes/wheel.dae"
            scale="1 1 1"/>
        </geometry>

      </visual>

      <collision>

        <geometry>
          <cylinder
            radius="${wheel_radius}"
            length="${wheel_thickness}"/>
        </geometry>

      </collision>

      <inertial>

        <origin
          xyz="0 0 0"
          rpy="0 0 0"/>

        <mass value="${wheel_mass}"/>

        <inertia
          ixx="${wheel_mass / 12.0 * (3.0 * wheel_radius * wheel_radius + wheel_thickness * wheel_thickness)}"
          ixy="0"
          ixz="0"
          iyy="${wheel_mass / 12.0 * (3.0 * wheel_radius * wheel_radius + wheel_thickness * wheel_thickness)}"
          iyz="0"
          izz="${wheel_mass / 2.0 * wheel_radius * wheel_radius}"/>

      </inertial>

    </link>


    <!-- Rear wheel rotation joint -->

    <joint
      name="wheel_${name}_joint"
      type="continuous">

      <parent link="base_link"/>
      <child link="wheel_${name}"/>

      <origin
        xyz="${x} ${y} ${z}"
        rpy="-1.57079632679 0 0"/>

      <axis xyz="0 0 1"/>

      <limit
        effort="1000"
        velocity="100"/>

    </joint>

  </xacro:macro>


  <!-- ========================================================= -->
  <!-- FRONT WHEEL + STEERING MACRO                              -->
  <!-- ========================================================= -->

  <xacro:macro name="front_wheel"
               params="name x y z flip">

    <!-- FRONT WHEEL -->

    <link name="wheel_${name}">

      <visual>

        <origin
          xyz="0 0 0"
          rpy="1.57079632679 ${flip * 3.14159265359} 0"/>

        <geometry>
          <mesh
            filename="package://car_description/meshes/wheel.dae"
            scale="1 1 1"/>
        </geometry>

      </visual>

      <collision>

        <geometry>
          <cylinder
            radius="${wheel_radius}"
            length="${wheel_thickness}"/>
        </geometry>

      </collision>

      <inertial>

        <origin
          xyz="0 0 0"
          rpy="0 0 0"/>

        <mass value="${wheel_mass}"/>

        <inertia
          ixx="${wheel_mass / 12.0 * (3.0 * wheel_radius * wheel_radius + wheel_thickness * wheel_thickness)}"
          ixy="0"
          ixz="0"
          iyy="${wheel_mass / 12.0 * (3.0 * wheel_radius * wheel_radius + wheel_thickness * wheel_thickness)}"
          iyz="0"
          izz="${wheel_mass / 2.0 * wheel_radius * wheel_radius}"/>

      </inertial>

    </link>


    <!-- STEERING LINK -->

    <link name="steer_${name}">

      <inertial>

        <origin
          xyz="-0.013054 -0.0295 0"
          rpy="0 0 0"/>

        <mass value="20.0"/>

        <inertia
          ixx="2.0"
          ixy="0"
          ixz="0"
          iyy="2.0"
          iyz="0"
          izz="2.0"/>

      </inertial>

    </link>


    <!-- STEERING JOINT -->

    <joint
      name="steer_${name}_joint"
      type="revolute">

      <parent link="base_link"/>
      <child link="steer_${name}"/>

      <origin
        xyz="${x} ${y} ${z}"
        rpy="0 0 0"/>

      <axis xyz="0 0 1"/>

      <limit
        lower="-0.6"
        upper="0.6"
        effort="1000"
        velocity="10"/>

    </joint>


    <!-- FRONT WHEEL ROTATION JOINT -->

    <joint
      name="wheel_${name}_joint"
      type="continuous">

      <parent link="steer_${name}"/>
      <child link="wheel_${name}"/>

      <origin
        xyz="0 0 0"
        rpy="-1.57079632679 0 0"/>

      <axis xyz="0 0 1"/>

      <limit
        effort="1000"
        velocity="100"/>

    </joint>

  </xacro:macro>


  <!-- ========================================================= -->
  <!-- BASE FOOTPRINT                                            -->
  <!-- ========================================================= -->

  <link name="base_footprint"/>


  <!-- ========================================================= -->
  <!-- BASE LINK                                                 -->
  <!-- ========================================================= -->

  <link name="base_link">

    <!-- Vehicle visual -->

    <visual>

      <origin
        xyz="0.035 0 0.025"
        rpy="0 0 0"/>

      <geometry>

        <xacro:if value="$(arg blue)">

          <mesh
            filename="package://car_description/meshes/blue_body.dae"
            scale="1 1 1"/>

        </xacro:if>

        <xacro:unless value="$(arg blue)">

          <mesh
            filename="package://car_description/meshes/orange_body.dae"
            scale="1 1 1"/>

        </xacro:unless>

      </geometry>

    </visual>


    <!-- Vehicle collision -->

    <collision>

      <origin
        xyz="0.035 0 0.025"
        rpy="0 0 0"/>

      <geometry>

        <mesh
          filename="package://car_description/meshes/body_collision.stl"
          scale="1 1 1"/>

      </geometry>

    </collision>


    <!-- Vehicle inertial -->

    <inertial>

      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <mass value="${body_mass}"/>

      <inertia
        ixx="${body_mass / 12.0 * (body_width * body_width + body_length * body_length)}"
        ixy="0"
        ixz="0"
        iyy="${body_mass / 12.0 * (body_length * body_length + body_depth * body_depth)}"
        iyz="0"
        izz="${body_mass / 12.0 * (body_width * body_width + body_depth * body_depth)}"/>

    </inertial>

  </link>


  <!-- ========================================================= -->
  <!-- BASE FOOTPRINT -> BASE LINK                               -->
  <!-- ========================================================= -->

  <joint
    name="base_link_joint"
    type="fixed">

    <origin
      xyz="${half_wheelbase} 0 ${wheel_radius}"
      rpy="0 0 0"/>

    <parent link="base_footprint"/>
    <child link="base_link"/>

  </joint>


  <!-- ========================================================= -->
  <!-- REAR LEFT WHEEL                                           -->
  <!-- ========================================================= -->

  <xacro:rear_wheel
    name="rl"
    x="${-half_wheelbase}"
    y="${half_rear_track_width}"
    z="0"
    flip="1"/>


  <!-- ========================================================= -->
  <!-- REAR RIGHT WHEEL                                          -->
  <!-- ========================================================= -->

  <xacro:rear_wheel
    name="rr"
    x="${-half_wheelbase}"
    y="${-half_rear_track_width}"
    z="0"
    flip="0"/>


  <!-- ========================================================= -->
  <!-- FRONT LEFT WHEEL                                          -->
  <!-- ========================================================= -->

  <xacro:front_wheel
    name="fl"
    x="${half_wheelbase}"
    y="${half_front_track_width}"
    z="0"
    flip="1"/>


  <!-- ========================================================= -->
  <!-- FRONT RIGHT WHEEL                                         -->
  <!-- ========================================================= -->

  <xacro:front_wheel
    name="fr"
    x="${half_wheelbase}"
    y="${-half_front_track_width}"
    z="0"
    flip="0"/>


  <!-- ========================================================= -->
  <!-- 2D LIDAR LINK                                             -->
  <!-- ========================================================= -->

  <link name="lidar_link">

    <visual>

      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <geometry>

        <cylinder
          radius="0.08"
          length="0.08"/>

      </geometry>

      <material name="lidar_black">

        <color
          rgba="0.05 0.05 0.05 1.0"/>

      </material>

    </visual>


    <collision>

      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <geometry>

        <cylinder
          radius="0.08"
          length="0.08"/>

      </geometry>

    </collision>


    <inertial>

      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <mass value="0.5"/>

      <inertia
        ixx="0.001"
        ixy="0"
        ixz="0"
        iyy="0.001"
        iyz="0"
        izz="0.001"/>

    </inertial>

  </link>


  <!-- ========================================================= -->
  <!-- BASE LINK -> LIDAR                                        -->
  <!-- ========================================================= -->

  <joint
    name="lidar_joint"
    type="fixed">

    <origin
      xyz="0 0 0.95"
      rpy="0 0 0"/>

    <parent link="base_link"/>
    <child link="lidar_link"/>

  </joint>


  <!-- ========================================================= -->
<!-- GAZEBO SIM 2D GPU LIDAR                                  -->
<!-- ========================================================= -->

  <gazebo reference="lidar_link">

    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>

      <always_on>true</always_on>

      <visualize>true</visualize>

      <update_rate>10</update_rate>

      <topic>/scan</topic>

      <lidar>

        <scan>

          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>

          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>

        </scan>

        <range>
          <min>0.10</min>
          <max>20.0</max>
          <resolution>0.01</resolution>
        </range>

      </lidar>

    </sensor>

  </gazebo>
  <gazebo>
      <plugin
        filename="gz-sim-sensors-system"
        name="gz::sim::systems::Sensors">
        <render_engine>ogre2</render_engine>
      </plugin>
  </gazebo>


  <!-- ========================================================= -->
  <!-- ROS 2 CONTROL                                             -->
  <!-- ========================================================= -->

  <ros2_control
    name="CarControlSystem"
    type="system">

    <hardware>

      <plugin>
        gz_ros2_control/GazeboSimSystem
      </plugin>

    </hardware>


    <!-- FRONT LEFT STEERING -->

    <joint name="steer_fl_joint">

      <command_interface name="position"/>

      <state_interface name="position"/>

      <state_interface name="velocity"/>

    </joint>


    <!-- FRONT RIGHT STEERING -->

    <joint name="steer_fr_joint">

      <command_interface name="position"/>

      <state_interface name="position"/>

      <state_interface name="velocity"/>

    </joint>


    <!-- REAR LEFT DRIVE -->

    <joint name="wheel_rl_joint">

      <command_interface name="velocity"/>

      <state_interface name="position"/>

      <state_interface name="velocity"/>

    </joint>


    <!-- REAR RIGHT DRIVE -->

    <joint name="wheel_rr_joint">

      <command_interface name="velocity"/>

      <state_interface name="position"/>

      <state_interface name="velocity"/>

    </joint>

  </ros2_control>


  <!-- ========================================================= -->
  <!-- GZ ROS 2 CONTROL PLUGIN                                   -->
  <!-- ========================================================= -->

  <gazebo>

    <plugin
      filename="gz_ros2_control-system"
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">

      <parameters>
        $(find car_description)/config/controllers.yaml
      </parameters>

    </plugin>

  </gazebo>


</robot>