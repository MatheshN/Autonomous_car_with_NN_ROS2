<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="car_world">

    <!-- Only Core System Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.81</gravity>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground -->
    <model name="ground_grass">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.15 0.35 0.15 1</ambient>
            <diffuse>0.15 0.35 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Asphalt Road -->
    <model name="asphalt_road">
      <static>true</static>
      <pose>20.0 0 0.005 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>50.0 8.0 0.01</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>50.0 8.0 0.01</size></box></geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Yellow Center Line -->
    <model name="road_line_center">
      <static>true</static>
      <pose>20.0 0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>50.0 0.15 0.01</size></box></geometry>
          <material>
            <ambient>0.9 0.8 0.1 1</ambient>
            <diffuse>0.9 0.8 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Side Barriers -->
    <model name="barrier_left">
      <static>true</static>
      <pose>20.0 4.25 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>50.0 0.4 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>50.0 0.4 1.0</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="barrier_right">
      <static>true</static>
      <pose>20.0 -4.25 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>50.0 0.4 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>50.0 0.4 1.0</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- TALL OBSTACLES FOR NN LIDAR TRAINING                        -->
    <!-- ============================================================ -->

    <!-- Tall Pillar 1 (Left Lane) -->
    <model name="tall_pillar_left">
      <static>true</static>
      <pose>6.0 1.8 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.35</radius><length>2.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.35</radius><length>2.0</length></cylinder></geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Tall Pillar 2 (Right Lane) -->
    <model name="tall_pillar_right">
      <static>true</static>
      <pose>12.0 -2.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.4</radius><length>2.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.4</radius><length>2.0</length></cylinder></geometry>
          <material>
            <ambient>0.2 0.2 0.8 1</ambient>
            <diffuse>0.2 0.2 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Large Parked Box Obstacle (Center-Right) -->
    <model name="parked_obstacle_box">
      <static>true</static>
      <pose>18.0 -1.2 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.5 1.2 1.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.5 1.2 1.6</size></box></geometry>
          <material>
            <ambient>0.9 0.5 0.1 1</ambient>
            <diffuse>0.9 0.5 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Tall Barrel (Center-Left) -->
    <model name="tall_barrel">
      <static>true</static>
      <pose>24.0 1.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.5</radius><length>2.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.5</radius><length>2.0</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.7 0.7 1</ambient>
            <diffuse>0.1 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>