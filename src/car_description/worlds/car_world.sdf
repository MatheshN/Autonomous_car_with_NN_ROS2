<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="car_world">

    <!-- Only Core System Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.81</gravity>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground -->
    <model name="ground_grass">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.15 0.35 0.15 1</ambient>
            <diffuse>0.15 0.35 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Asphalt Road -->
    <model name="asphalt_road">
      <static>true</static>
      <pose>20.0 0 0.005 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>50.0 8.0 0.01</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>50.0 8.0 0.01</size></box></geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Yellow Center Line -->
    <model name="road_line_center">
      <static>true</static>
      <pose>20.0 0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>50.0 0.15 0.01</size></box></geometry>
          <material>
            <ambient>0.9 0.8 0.1 1</ambient>
            <diffuse>0.9 0.8 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Barriers -->
    <model name="barrier_left">
      <static>true</static>
      <pose>20.0 4.25 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>50.0 0.4 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>50.0 0.4 1.0</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="barrier_right">
      <static>true</static>
      <pose>20.0 -4.25 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>50.0 0.4 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>50.0 0.4 1.0</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacles -->
    <model name="traffic_cone_1">
      <static>true</static>
      <pose>8.0 1.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.3 0.0 1</ambient>
            <diffuse>0.9 0.3 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>